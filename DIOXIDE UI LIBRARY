--==============================================================
-- BUILD: CLOSE / OPEN
--==============================================================
function WindowClass:_buildCloseOpen()
    local gui, content = self._gui, self._content

    local openBtn = Instance.new("TextButton")
    openBtn.Text = ""
    openBtn.AutoButtonColor = false
    openBtn.AnchorPoint = Vector2.new(0, 0.5)
    openBtn.Position = UDim2.new(0, 14, 0.5, 0)
    openBtn.Size = UDim2.fromOffset(60, 60)
    openBtn.BorderSizePixel = 0
    openBtn.Visible = false
    corner(openBtn, 14)
    stroke(openBtn, 4)
    crystal(openBtn, 0.05, 14)
    newText(openBtn, "D", 40, { Size = UDim2.fromScale(1, 1), ZIndex = 4 })
    openBtn.Parent = gui
    self._openBtn = openBtn

    -- close shadow + close btn
    local closeShadow = Instance.new("Frame")
    place(closeShadow, 325, 0, 99, 76)
    closeShadow.Position += UDim2.fromOffset(0, 5)
    closeShadow.BackgroundColor3 = OUTLINE
    closeShadow.BackgroundTransparency = 0.6
    closeShadow.BorderSizePixel = 0
    closeShadow.ZIndex = 0
    corner(closeShadow, 13)
    closeShadow.Parent = content

    local closeBtn = Instance.new("TextButton")
    closeBtn.Text = ""
    closeBtn.AutoButtonColor = false
    closeBtn.BorderSizePixel = 0
    place(closeBtn, 325, 0, 99, 76)
    corner(closeBtn, 13)
    stroke(closeBtn, 4)
    crystal(closeBtn, 0.03, 13,
        Color3.fromRGB(255, 150, 150),
        Color3.fromRGB(235, 45, 45),
        Color3.fromRGB(120, 8, 8)
    )
    local xLbl = newText(closeBtn, "X", 56, { Size = UDim2.fromScale(1, 1), ZIndex = 4 })
    local csc = Instance.new("UIScale")
    csc.Parent = closeBtn

    closeBtn.MouseEnter:Connect(function()
        tw(csc, 0.12, { Scale = 1.06 })
        tw(xLbl, 0.2, { Rotation = 90 })
    end)
    closeBtn.MouseLeave:Connect(function()
        tw(csc, 0.12, { Scale = 1 })
        tw(xLbl, 0.2, { Rotation = 0 })
    end)
    closeBtn.MouseButton1Click:Connect(function() self:SetOpen(false) end)
    closeBtn.Parent = content

    openBtn.MouseButton1Click:Connect(function() self:SetOpen(true) end)
end

--==============================================================
-- INPUT BINDING + LOOP + PUBLIC METHODS
--==============================================================
function WindowClass:_bindInput(key)
    self:_connect(UserInputService.InputBegan, function(input, processed)
        if not processed and input.KeyCode == key then
            self:SetOpen(not self._opened)
        end
    end)
end

function WindowClass:_startLoop()
    local frames, last = 0, os.clock()
    self:_connect(RunService.RenderStepped, function()
        frames = frames + 1
        local now = os.clock()
        if now - last >= 1 then
            self._fpsLabel.Text = "FPS: " .. frames
            frames = 0
            last = now
            local ok, ping = pcall(function()
                return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
            end)
            self._pingLabel.Text = "Ping: " .. (ok and math.floor(ping) or 0) .. "ms"
        end
    end)
end

function WindowClass:Notify(msg)
    if not self._notifOn then return end
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0)
    f.Size = UDim2.fromOffset(320, 46)
    f.Position = UDim2.new(0.5, 0, 0, -70)
    f.BorderSizePixel = 0
    corner(f, 10)
    stroke(f, 3)
    crystal(f, 0.15)
    newText(f, msg, 20, { Size = UDim2.fromScale(1, 1) })
    f.Parent = self._gui
    tw(f, 0.3, { Position = UDim2.new(0.5, 0, 0, 24) })
    task.delay(2, function()
        if f.Parent then
            tw(f, 0.3, { Position = UDim2.new(0.5, 0, 0, -70) })
            task.wait(0.35)
            f:Destroy()
        end
    end)
end

function WindowClass:SetOpen(v)
    self._opened = v
    if v then
        self._root.Visible = true
        self._openBtn.Visible = false
        self._popScale.Scale = 0.8
        tw(self._popScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
    else
        tw(self._popScale, 0.15, { Scale = 0.85 })
        task.delay(0.15, function()
            if not self._opened then
                self._root.Visible = false
                self._openBtn.Visible = true
            end
        end)
    end
end

function WindowClass:Unload()
    for _, c in ipairs(self._conns) do c:Disconnect() end
    self._conns = {}
    self._gui:Destroy()
end

--==============================================================
-- TABS
--==============================================================
function WindowClass:_selectPage(name)
    local pg = self._pages[name]
    if not pg then return end
    for n, p in pairs(self._pages) do
        if n ~= name then p.Visible = false end
    end
    if self._currentPage ~= name then
        pg.Position = UDim2.fromOffset(10, 76)
        pg.Visible = true
        tw(pg, 0.22, { Position = UDim2.fromOffset(10, 62) })
    end
    self._currentPage = name
    for n, t in pairs(self._tabs) do
        local on = (n == name)
        tw(t.btn, 0.2, { BackgroundTransparency = on and 0 or 0.32 })
        t.stroke.Color = on and WHITE or OUTLINE
        t.glow.Visible = on
    end
    self._headerTitle.Text = name
end

function WindowClass:Tab(name)
    local idx = #self._tabs + 1
    local slot = TAB_SLOTS[idx]
    if not slot then
        warn("[DioxideLib] Hết slot tab (max " .. #TAB_SLOTS .. "). Reuse slot 1.")
        slot = TAB_SLOTS[1]
    end
    local x, y, w, h = slot[1], slot[2], slot[3], slot[4]
    local content = self._content

    -- Glow
    local glow = Instance.new("Frame")
    place(glow, x, y, w, h)
    glow.Position -= UDim2.fromOffset(7, 7)
    glow.Size += UDim2.fromOffset(14, 14)
    glow.BackgroundColor3 = GREEN
    glow.BackgroundTransparency = 0.6
    glow.BorderSizePixel = 0
    glow.Visible = false
    glow.ZIndex = 0
    corner(glow, 18)
    glow.Parent = content

    -- Shadow
    local shadow = Instance.new("Frame")
    place(shadow, x, y, w, h)
    shadow.Position += UDim2.fromOffset(0, 5)
    shadow.BackgroundColor3 = OUTLINE
    shadow.BackgroundTransparency = 0.6
    shadow.BorderSizePixel = 0
    shadow.ZIndex = 0
    corner(shadow, 11)
    shadow.Parent = content

    -- Button
    local b = Instance.new("TextButton")
    b.Name = "Tab_" .. name
    b.Text = ""
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    place(b, x, y, w, h)
    corner(b, 11)
    local st = stroke(b, 4)
    crystal(b, 0.32, 11)
    newText(b, name, 22, { Size = UDim2.fromScale(1, 1), ZIndex = 4 })

    local sc = Instance.new("UIScale")
    sc.Parent = b
    b.MouseEnter:Connect(function() tw(sc, 0.12, { Scale = 1.06 }) end)
    b.MouseLeave:Connect(function() tw(sc, 0.12, { Scale = 1 }) end)
    b.MouseButton1Down:Connect(function() tw(sc, 0.08, { Scale = 0.94 }) end)
    b.MouseButton1Up:Connect(function() tw(sc, 0.08, { Scale = 1.06 }) end)
    b.MouseButton1Click:Connect(function() self:_selectPage(name) end)
    b.Parent = content

    -- Page (ScrollingFrame)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Position = UDim2.fromOffset(10, 62)
    page.Size = UDim2.new(1, -20, 1, -72)
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 5
    page.ScrollBarImageColor3 = GREEN
    page.Visible = false
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 8)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = page
    page.Parent = self._mainBox

    self._tabs[name] = { btn = b, stroke = st, glow = glow }
    self._pages[name] = page

    -- First tab auto-select
    if not self._currentPage then
        self:_selectPage(name)
    end

    return setmetatable({ _win = self, _page = page, _name = name }, TabClass)
end

--==============================================================
-- TAB CLASS
--==============================================================
function TabClass:_row(h)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(1, -6, 0, h)
    r.BackgroundColor3 = DARK
    r.BackgroundTransparency = 0.25
    r.BorderSizePixel = 0
    r.LayoutOrder = self._win:_nextOrder()
    corner(r, 8)
    stroke(r, 2)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(WHITE, Color3.fromRGB(150, 150, 150))
    g.Rotation = 90
    g.Parent = r
    r.Parent = self._page
    return r
end

function TabClass:_hover(r, btn)
    btn.MouseEnter:Connect(function() tw(r, 0.1, { BackgroundTransparency = 0.1 }) end)
    btn.MouseLeave:Connect(function() tw(r, 0.1, { BackgroundTransparency = 0.25 }) end)
end

function TabClass:Section(text)
    local f = Instance.new("Frame")
    f.BackgroundTransparency = 1
    f.Size = UDim2.new(1, -6, 0, 26)
    f.LayoutOrder = self._win:_nextOrder()
    f.Parent = self._page
    local up = string.upper(text)
    local w = TextService:GetTextSize(up, 18, FONT, Vector2.new(400, 30)).X
    newText(f, up, 18, {
        Size = UDim2.fromOffset(w + 4, 26),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = GREEN_L,
    })
    local line = Instance.new("Frame")
    line.Position = UDim2.fromOffset(w + 14, 12)
    line.Size = UDim2.new(1, -(w + 14), 0, 2)
    line.BackgroundColor3 = GREEN
    line.BackgroundTransparency = 0.55
    line.BorderSizePixel = 0
    line.Parent = f
    return self
end

function TabClass:Stat(a, b)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 66)
    row.BackgroundTransparency = 1
    row.LayoutOrder = self._win:_nextOrder()
    row.Parent = self._page
    local setters = {}
    for i, d in ipairs({ a, b }) do
        if d then
            local c = Instance.new("Frame")
            c.Size = UDim2.new(0.5, -4, 1, 0)
            c.Position = UDim2.new((i - 1) * 0.5, (i - 1) * 4, 0, 0)
            c.BackgroundColor3 = DARK
            c.BackgroundTransparency = 0.25
            c.BorderSizePixel = 0
            corner(c, 8)
            stroke(c, 2)
            c.Parent = row
            newText(c, string.upper(d.Label or "?"), 15, {
                Position = UDim2.fromOffset(0, 6),
                Size = UDim2.new(1, 0, 0, 18),
                TextColor3 = GREEN_L,
            })
            local v = newText(c, tostring(d.Value or "-"), 28, {
                Position = UDim2.fromOffset(0, 26),
                Size = UDim2.new(1, 0, 0, 34),
            })
            setters[i] = function(s) v.Text = tostring(s) end
        end
    end
    return setters[1], setters[2]
end

function TabClass:Toggle(cfg)
    cfg = cfg or {}
    local label    = cfg.Title or "Toggle"
    local default  = cfg.Default or false
    local cb       = cfg.Callback
    local countIt  = cfg.CountIt
    if countIt == nil then countIt = true end

    local r = self:_row(46)
    local accent = Instance.new("Frame")
    accent.Position = UDim2.fromOffset(6, 9)
    accent.Size = UDim2.new(0, 4, 1, -18)
    accent.BorderSizePixel = 0
    corner(accent, 2)
    accent.Parent = r

    newText(r, label, 22, {
        Position = UDim2.fromOffset(20, 0),
        Size = UDim2.new(1, -100, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local track = Instance.new("Frame")
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -12, 0.5, 0)
    track.Size = UDim2.fromOffset(60, 28)
    track.BorderSizePixel = 0
    corner(track, 14)
    stroke(track, 2)
    track.Parent = r
    local tg = Instance.new("UIGradient")
    tg.Color = ColorSequence.new(WHITE, Color3.fromRGB(150, 150, 150))
    tg.Rotation = 90
    tg.Parent = track

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(22, 22)
    knob.BackgroundColor3 = WHITE
    knob.BorderSizePixel = 0
    corner(knob, 11)
    stroke(knob, 2)
    knob.Parent = track

    local state = default
    local function render(animate)
        local col = state and GREEN or OFF
        local acc = state and GREEN or Color3.fromRGB(50, 60, 55)
        local pos = UDim2.new(0, state and 47 or 13, 0.5, 0)
        if animate then
            tw(track,  0.15, { BackgroundColor3 = col })
            tw(accent, 0.15, { BackgroundColor3 = acc })
            tw(knob,   0.18, { Position = pos }, Enum.EasingStyle.Back)
        else
            track.BackgroundColor3 = col
            accent.BackgroundColor3 = acc
            knob.Position = pos
        end
    end
    render(false)
    if default and countIt then self._win:_bumpCount(1) end

    local click = Instance.new("TextButton")
    click.Text = ""
    click.BackgroundTransparency = 1
    click.Size = UDim2.fromScale(1, 1)
    click.ZIndex = 8
    click.Parent = r
    self:_hover(r, click)

    click.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        if countIt then self._win:_bumpCount(state and 1 or -1) end
        self._win:Notify(label .. ": " .. (state and "ON" or "OFF"))
        if cb then cb(state) end
    end)

    return self
end

function TabClass:Slider(cfg)
    cfg = cfg or {}
    local label   = cfg.Title or "Slider"
    local min     = cfg.Min or 0
    local max     = cfg.Max or 100
    local default = cfg.Default or min
    local cb      = cfg.Callback
    local suffix  = cfg.Suffix or ""

    local r = self:_row(68)
    newText(r, label, 22, {
        Position = UDim2.fromOffset(14, 4),
        Size = UDim2.new(1, -110, 0, 26),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local val = newText(r, default .. suffix, 22, {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -14, 0, 4),
        Size = UDim2.fromOffset(90, 26),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = GREEN_L,
    })

    local hit = Instance.new("TextButton")
    hit.Text = ""
    hit.BackgroundTransparency = 1
    hit.Position = UDim2.fromOffset(10, 34)
    hit.Size = UDim2.new(1, -20, 0, 30)
    hit.Parent = r

    local bar = Instance.new("Frame")
    bar.AnchorPoint = Vector2.new(0, 0.5)
    bar.Position = UDim2.new(0, 4, 0.5, 0)
    bar.Size = UDim2.new(1, -8, 0, 14)
    bar.BackgroundColor3 = Color3.fromRGB(10, 14, 12)
    bar.BorderSizePixel = 0
    corner(bar, 7)
    stroke(bar, 2)
    bar.Parent = hit

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BorderSizePixel = 0
    corner(fill, 7)
    crystal(fill, 0, 7)
    fill.Parent = bar

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(22, 22)
    knob.BackgroundColor3 = WHITE
    knob.BorderSizePixel = 0
    corner(knob, 11)
    stroke(knob, 3, GREEN)
    knob.ZIndex = 4
    knob.Parent = bar

    local function setAlpha(a)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.fromScale(a, 0.5)
    end
    setAlpha((default - min) / (max - min))

    local dragging = false
    local function fromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * a + 0.5)
        setAlpha((v - min) / (max - min))
        val.Text = v .. suffix
        if cb then cb(v) end
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tw(knob, 0.1, { Size = UDim2.fromOffset(27, 27) })
            fromX(input.Position.X)
        end
    end)
    self._win:_connect(UserInputService.InputChanged, function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            fromX(input.Position.X)
        end
    end)
    self._win:_connect(UserInputService.InputEnded, function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            dragging = false
            tw(knob, 0.1, { Size = UDim2.fromOffset(22, 22) })
        end
    end)

    return self
end

function TabClass:_smallBtn(symbol, pos)
    local b = Instance.new("TextButton")
    b.Text = ""
    b.AutoButtonColor = false
    b.AnchorPoint = Vector2.new(1, 0.5)
    b.Position = pos
    b.Size = UDim2.fromOffset(30, 30)
    b.BorderSizePixel = 0
    b.ZIndex = 9
    corner(b, 8)
    stroke(b, 2)
    crystal(b, 0.1, 8)
    newText(b, symbol, 22, { Size = UDim2.fromScale(1, 1), ZIndex = 10 })
    return b
end

function TabClass:Dropdown(cfg)
    cfg = cfg or {}
    local label   = cfg.Title or "Dropdown"
    local options = cfg.Options or {}
    local cb      = cfg.Callback
    if #options == 0 then options = { "-" } end

    local r = self:_row(46)
    newText(r, label, 22, {
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -200, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local i = 1
    local val = newText(r, options[i], 18, {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -44, 0.5, 0),
        Size = UDim2.fromOffset(116, 30),
        TextColor3 = GREEN_L,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local prev = self:_smallBtn("<", UDim2.new(1, -164, 0.5, 0))
    local nxt  = self:_smallBtn(">", UDim2.new(1, -10,  0.5, 0))
    prev.Parent = r
    nxt.Parent  = r

    local function step(d)
        i = (i - 1 + d) % #options + 1
        val.Text = options[i]
        self._win:Notify(label .. ": " .. options[i])
        if cb then cb(options[i]) end
    end
    prev.MouseButton1Click:Connect(function() step(-1) end)
    nxt.MouseButton1Click:Connect(function() step(1) end)

    return self
end

function TabClass:Button(cfg)
    cfg = cfg or {}
    local label = cfg.Title or "Button"
    local cb    = cfg.Callback

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 46)
    b.Text = ""
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.LayoutOrder = self._win:_nextOrder()
    corner(b, 9)
    stroke(b, 3)
    crystal(b, 0.1, 9)
    newText(b, label, 22, { Size = UDim2.fromScale(1, 1), ZIndex = 4 })

    local sc = Instance.new("UIScale")
    sc.Parent = b
    b.MouseEnter:Connect(function() tw(sc, 0.12, { Scale = 1.02 }) end)
    b.MouseLeave:Connect(function() tw(sc, 0.12, { Scale = 1 }) end)
    b.MouseButton1Down:Connect(function() tw(sc, 0.08, { Scale = 0.96 }) end)
    b.MouseButton1Up:Connect(function() tw(sc, 0.08, { Scale = 1.02 }) end)
    b.MouseButton1Click:Connect(function()
        self._win:Notify(label)
        if cb then cb() end
    end)
    b.Parent = self._page

    return self
end

function TabClass:Progress(cfg)
    cfg = cfg or {}
    local label = cfg.Title or "Progress"
    local cur   = cfg.Value or 0
    local max   = cfg.Max or 100

    local r = self:_row(62)
    newText(r, label, 22, {
        Position = UDim2.fromOffset(14, 4),
        Size = UDim2.new(1, -28, 0, 26),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(14, 34)
    bar.Size = UDim2.new(1, -28, 0, 20)
    bar.BackgroundColor3 = Color3.fromRGB(10, 14, 12)
    bar.BorderSizePixel = 0
    corner(bar, 8)
    stroke(bar, 2)
    bar.Parent = r

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(cur / max, 1)
    fill.BorderSizePixel = 0
    corner(fill, 8)
    crystal(fill, 0, 8)
    fill.Parent = bar

    local lbl = newText(bar, cur .. "/" .. max, 16, {
        Size = UDim2.fromScale(1, 1), ZIndex = 6,
    })

    return function(c)
        tw(fill, 0.3, { Size = UDim2.fromScale(math.clamp(c / max, 0, 1), 1) })
        lbl.Text = c .. "/" .. max
    end
end

