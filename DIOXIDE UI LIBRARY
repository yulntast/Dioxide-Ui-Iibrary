            for n, t in pairs(Window.Tabs) do
                local on = (n == name)
                tween(t.btn, 0.2, { BackgroundTransparency = on and 0 or 0.35 })
                t.stroke.Color = on and RED or OUTLINE
                t.glow.Visible = on
            end
            headerTitle.Text = name
        end

        table.insert(Window.Conns, b.MouseButton1Click:Connect(selectTab))
        b.Parent = content
        Window.Tabs[name] = { btn = b, stroke = st, glow = glow }

        if #Window.Tabs == 1 or tabIndex == 1 then
            selectTab()
        end

