local function corner(inst, r) return nil end

local function stroke(inst, thick, color, transp)
    local s = Instance.new("UIStroke")
    s.Thickness = thick
    s.Color = color or OUTLINE
    s.Transparency = transp or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

-- crystal(inst, transp, preset)
--   preset = "silver" | "fire" | "orbit" (default) | "custom" (kèm light/mid/dark)
local function crystal(inst, transp, preset, light, mid, dark)
    inst.BackgroundColor3 = WHITE
    inst.BackgroundTransparency = transp or 0.15
    preset = preset or "orbit"

    local g = Instance.new("UIGradient")
    if preset == "silver" then
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, SILVER_L),
            ColorSequenceKeypoint.new(0.5, SILVER),
            ColorSequenceKeypoint.new(1, SILVER_D),
        })
        g.Rotation = 90
    elseif preset == "fire" then
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, RED_L),
            ColorSequenceKeypoint.new(0.5, RED),
            ColorSequenceKeypoint.new(1, RED_D),
        })
        g.Rotation = 90
    elseif preset == "custom" then
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, light or SILVER_L),
            ColorSequenceKeypoint.new(0.5, mid or SILVER),
            ColorSequenceKeypoint.new(1, dark or SILVER_D),
        })
        g.Rotation = 90
    else -- "orbit" : đỏ -> tím giao -> xanh, chéo góc
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    RED_L),
            ColorSequenceKeypoint.new(0.35, RED),
            ColorSequenceKeypoint.new(0.65, Color3.fromRGB(150, 60, 140)),
            ColorSequenceKeypoint.new(1,    BLUE),
        })
        g.Rotation = 45
    end
    g.Parent = inst

    local gloss = Instance.new("Frame")
    gloss.Name = "Gloss"
    gloss.BorderSizePixel = 0
    gloss.BackgroundColor3 = WHITE
    gloss.Position = UDim2.fromOffset(4, 3)
    gloss.Size = UDim2.new(1, -8, 0.42, 0)
    gloss.ZIndex = 2

    local gg = Instance.new("UIGradient")
    gg.Rotation = 90
    gg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.3),
        NumberSequenceKeypoint.new(1, 1),
    })
    gg.Parent = gloss
    gloss.Parent = inst

    local edge = Instance.new("Frame")
    edge.Name = "Edge"
    edge.BackgroundTransparency = 1
    edge.Position = UDim2.fromOffset(2, 2)
    edge.Size = UDim2.new(1, -4, 1, -4)
    edge.ZIndex = 2
    stroke(edge, 1.5, WHITE, 0.6)
    edge.Parent = inst
end

local function text(parent, txt, size, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font = FONT
    l.Text = txt
    l.TextSize = size
    l.TextColor3 = WHITE
    l.ZIndex = 5
    l.TextXAlignment = Enum.TextXAlignment.Center
    for k, v in pairs(props or {}) do l[k] = v end
    local s = Instance.new("UIStroke")
    s.Thickness = math.max(1.5, size / 12)
    s.Color = OUTLINE
    s.Parent = l
    l.Parent = parent
    return l
end

local function tween(inst, t, goal, style, dir)
    local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
    tw:Play()
    return tw
end

local function attachDrag(handle, target, conns)
    local dragging, dragStart, startPos = false, nil, nil
    handle.Active = true
    table.insert(conns, handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end))
    table.insert(conns, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

