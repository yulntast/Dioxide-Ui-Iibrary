    TweenService:Create(stroke, TWEEN_FAST, {Transparency = 0}):Play()
    TweenService:Create(titleLbl, TWEEN_FAST, {TextTransparency = 0}):Play()
    TweenService:Create(descLbl, TWEEN_FAST, {TextTransparency = 0}):Play()

    task.delay(duration, function()
        if card and card.Parent then
            local tw = TweenService:Create(card, TWEEN_FAST, {BackgroundTransparency = 1})
            TweenService:Create(stroke, TWEEN_FAST, {Transparency = 1}):Play()
            TweenService:Create(titleLbl, TWEEN_FAST, {TextTransparency = 1}):Play()
            TweenService:Create(descLbl, TWEEN_FAST, {TextTransparency = 1}):Play()
            tw:Play()
            tw.Completed:Connect(function()
                if card then card:Destroy() end
            end)
        end
    end)
end

function UILibrary:CreateTab(iconAssetId)
    local tabObj = {}
    local library = self

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 30, 0, 22)
    tabBtn.BackgroundColor3 = library.AccentColor
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = ""
    tabBtn.ClipsDescendants = true
    tabBtn.Parent = self.TabContainer

    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 3)

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 15, 0, 15)
    icon.Position = UDim2.new(0.5, -7, 0.5, -7)
    icon.BackgroundTransparency = 1
    icon.Image = iconAssetId
    icon.ImageColor3 = Color3.fromRGB(120, 125, 140)
    icon.Parent = tabBtn

    local pageGroup = Instance.new("Frame")
    pageGroup.Size = UDim2.new(1, 0, 1, 0)
    pageGroup.BackgroundTransparency = 1
    pageGroup.Visible = false
    pageGroup.ClipsDescendants = true
    pageGroup.Parent = self.ContentContainer

    local pageScroll = Instance.new("ScrollingFrame")
    pageScroll.Size = UDim2.new(1, 0, 1, 0)
    pageScroll.BackgroundTransparency = 1
    pageScroll.ScrollBarThickness = 0
    pageScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    pageScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    pageScroll.ClipsDescendants = true
    pageScroll.Parent = pageGroup

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingTop = UDim.new(0, 2)
    pagePadding.PaddingBottom = UDim.new(0, 20)
    pagePadding.PaddingLeft = UDim.new(0, 2)
    pagePadding.PaddingRight = UDim.new(0, 6)
    pagePadding.Parent = pageScroll

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.Parent = pageScroll

    tabBtn.MouseButton1Click:Connect(function()
        if self.ActiveTab == tabObj then return end

        if self.ActiveTab then
            local oldTab = self.ActiveTab
            TweenService:Create(oldTab.TabButton, TWEEN_FAST, {BackgroundTransparency = 1}):Play()
            TweenService:Create(oldTab.Icon, TWEEN_FAST, {ImageColor3 = Color3.fromRGB(120, 125, 140)}):Play()
            oldTab.PageGroup.Visible = false
        end

        self.ActiveTab = tabObj
        pageGroup.Visible = true

        TweenService:Create(tabBtn, TWEEN_FAST, {BackgroundTransparency = 0, BackgroundColor3 = library.AccentColor}):Play()
        TweenService:Create(icon, TWEEN_FAST, {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end)

    if #self.Tabs == 0 then
        pageGroup.Visible = true
        self.ActiveTab = tabObj
        tabBtn.BackgroundTransparency = 0
        tabBtn.BackgroundColor3 = library.AccentColor
        icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    end

    tabObj.TabButton = tabBtn
    tabObj.Icon = icon
    tabObj.PageGroup = pageGroup
    tabObj.ScrollFrame = pageScroll

    function tabObj:AddSection(title)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 18)
        label.BackgroundTransparency = 1
        label.Text = string.upper(title)
        label.TextColor3 = Color3.fromRGB(110, 115, 130)
        label.Font = MAIN_FONT
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.Parent = pageScroll
    end

    function tabObj:AddToggle(text, default, callback)
        local state = default or false

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 22)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.ClipsDescendants = true
        btn.Parent = pageScroll

        local box = Instance.new("Frame")
        box.Size = UDim2.new(0, 14, 0, 14)
        box.Position = UDim2.new(0, 2, 0.5, -7)
        box.BackgroundColor3 = state and library.AccentColor or Color3.fromRGB(28, 30, 38)
        box.Parent = btn

        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 2)

        local boxStroke = Instance.new("UIStroke")
        boxStroke.Color = state and library.AccentColor or Color3.fromRGB(50, 52, 65)
        boxStroke.Parent = box

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, -25, 1, 0)
        txt.Position = UDim2.new(0, 24, 0, 0)
        txt.BackgroundTransparency = 1
        txt.Text = text
        txt.TextColor3 = state and Color3.fromRGB(240, 245, 255) or Color3.fromRGB(160, 165, 180)
        txt.Font = MAIN_FONT
        txt.TextSize = 11
        txt.TextXAlignment = Enum.TextXAlignment.Left
        txt.TextTruncate = Enum.TextTruncate.AtEnd
        txt.Parent = btn

        btn.MouseButton1Click:Connect(function()
            state = not state
            local targetBg = state and library.AccentColor or Color3.fromRGB(28, 30, 38)
            local targetStr = state and library.AccentColor or Color3.fromRGB(50, 52, 65)
            local targetTxt = state and Color3.fromRGB(240, 245, 255) or Color3.fromRGB(160, 165, 180)

            TweenService:Create(box, TWEEN_FAST, {BackgroundColor3 = targetBg}):Play()
            TweenService:Create(boxStroke, TWEEN_FAST, {Color = targetStr}):Play()
            TweenService:Create(txt, TWEEN_FAST, {TextColor3 = targetTxt}):Play()

            if callback then callback(state) end
        end)

        if default and callback then callback(true) end
    end

    function tabObj:AddSlider(text, min, max, default, callback)
        local value = default or min
        local dragging = false

        local sliderFrame = Instance.new("TextButton")
        sliderFrame.Size = UDim2.new(1, 0, 0, 36)
        sliderFrame.BackgroundTransparency = 1
        sliderFrame.Text = ""
        sliderFrame.ClipsDescendants = true
        sliderFrame.Parent = pageScroll

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(0.7, 0, 0, 16)
        txt.BackgroundTransparency = 1
        txt.Text = text
        txt.TextColor3 = Color3.fromRGB(200, 205, 220)
        txt.Font = MAIN_FONT
        txt.TextSize = 11
        txt.TextXAlignment = Enum.TextXAlignment.Left
        txt.TextTruncate = Enum.TextTruncate.AtEnd
        txt.Parent = sliderFrame

        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(0.3, 0, 0, 16)
        valLabel.Position = UDim2.new(0.7, 0, 0, 0)
        valLabel.BackgroundTransparency = 1
        valLabel.Text = tostring(value)
        valLabel.TextColor3 = Color3.fromRGB(140, 145, 160)
        valLabel.Font = MAIN_FONT
        valLabel.TextSize = 10
        valLabel.TextXAlignment = Enum.TextXAlignment.Right
        valLabel.Parent = sliderFrame

        local barBg = Instance.new("Frame")
        barBg.Size = UDim2.new(1, 0, 0, 6)
        barBg.Position = UDim2.new(0, 0, 0, 22)
        barBg.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
        barBg.Parent = sliderFrame

        Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 2)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(math.clamp((value - min) / math.max(1, max - min), 0, 1), 0, 1, 0)
        fill.BackgroundColor3 = library.AccentColor
        fill.Parent = barBg

        Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 2)

        local function Update(input)
            local width = math.max(1, barBg.AbsoluteSize.X)
            local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / width, 0, 1)
            value = math.floor(min + ((max - min) * pos))
            valLabel.Text = tostring(value)
            TweenService:Create(fill, TWEEN_FAST, {Size = UDim2.new(pos, 0, 1, 0)}):Play()
            if callback then callback(value) end
        end

        sliderFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                Update(input)
            end
        end)

        table.insert(library.Connections, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))

        table.insert(library.Connections, UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                Update(input)
            end
        end))
    end

    function tabObj:AddButton(text, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(200, 205, 220)
        btn.Font = MAIN_FONT
        btn.TextSize = 11
        btn.TextTruncate = Enum.TextTruncate.AtEnd
        btn.ClipsDescendants = true
        btn.Parent = pageScroll

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)

        local btnStroke = Instance.new("UIStroke")
        btnStroke.Color = Color3.fromRGB(50, 52, 65)
        btnStroke.Parent = btn

        btn.MouseButton1Click:Connect(function()
            if callback then callback() end
        end)
    end

    function tabObj:AddDropdown(text, list, default, callback)
        local open = false
        local selected = default or list[1] or "None"

        local dropFrame = Instance.new("Frame")
        dropFrame.Size = UDim2.new(1, 0, 0, 26)
        dropFrame.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
        dropFrame.ClipsDescendants = true
        dropFrame.Parent = pageScroll

        Instance.new("UICorner", dropFrame).CornerRadius = UDim.new(0, 3)

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(50, 52, 65)
        stroke.Parent = dropFrame

        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, 0, 0, 26)
        mainBtn.BackgroundTransparency = 1
        mainBtn.Text = "  " .. text .. ": " .. tostring(selected)
        mainBtn.TextColor3 = Color3.fromRGB(200, 205, 220)
        mainBtn.Font = MAIN_FONT
        mainBtn.TextSize = 11
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.TextTruncate = Enum.TextTruncate.AtEnd
        mainBtn.Parent = dropFrame

        local listContainer = Instance.new("Frame")
        listContainer.Size = UDim2.new(1, 0, 0, #list * 20)
        listContainer.Position = UDim2.new(0, 0, 0, 26)
        listContainer.BackgroundTransparency = 1
        listContainer.ClipsDescendants = true
        listContainer.Parent = dropFrame

        local listLayout = Instance.new("UIListLayout")
        listLayout.Parent = listContainer

        for _, item in ipairs(list) do
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, 0, 0, 20)
            itemBtn.BackgroundTransparency = 1
            itemBtn.Text = "    " .. tostring(item)
            itemBtn.TextColor3 = Color3.fromRGB(150, 155, 170)
            itemBtn.Font = MAIN_FONT
            itemBtn.TextSize = 10
            itemBtn.TextXAlignment = Enum.TextXAlignment.Left
            itemBtn.TextTruncate = Enum.TextTruncate.AtEnd
            itemBtn.Parent = listContainer

            itemBtn.MouseButton1Click:Connect(function()
                selected = item
                mainBtn.Text = "  " .. text .. ": " .. tostring(selected)
                open = false
                TweenService:Create(dropFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 26)}):Play()
                if callback then callback(selected) end
            end)
        end

        mainBtn.MouseButton1Click:Connect(function()
            open = not open
            local targetH = open and (26 + (#list * 20)) or 26
            TweenService:Create(dropFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, targetH)}):Play()
        end)
    end

    table.insert(self.Tabs, tabObj)
    return tabObj
end

return UILibrary
