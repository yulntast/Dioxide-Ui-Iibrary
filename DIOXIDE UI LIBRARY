        table.insert(Window.Conns, b.MouseEnter:Connect(function() tween(sc, 0.12, { Scale = 1.06 }) end))
        table.insert(Window.Conns, b.MouseLeave:Connect(function() tween(sc, 0.12, { Scale = 1 }) end))
