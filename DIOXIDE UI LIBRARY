    local Window = {
        Conns = {},
        Pages = {},
        Tabs = {},
        Shapes = {},
        ActiveCount = 0,
        NotifOn = true,
        UserScale = 1,
        Order = 0,
        CurrentPage = nil
    }

    local function ord()
        Window.Order += 1
        return Window.Order
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = hubName
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = parentGui
    Window.Gui = gui

    local root = Instance.new("Frame")
    root.Name = "Root"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
    root.Size = UDim2.fromOffset(BASE_W * K, BASE_H * K)
    root.BackgroundTransparency = 1
    root.Parent = gui
    Window.Root = root

    local fitScale = Instance.new("UIScale")
    fitScale.Parent = root

    local function fit()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local base = math.clamp(math.min(vp.X * 0.96 / (BASE_W * K), vp.Y * 0.94 / (BASE_H * K)), 0.35, 1)
        fitScale.Scale = base * Window.UserScale
    end
    fit()
    if workspace.CurrentCamera then
        table.insert(Window.Conns, workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit))
    end

    local content = Instance.new("Frame")
    content.Name = "Content"
    content.AnchorPoint = Vector2.new(0.5, 0.5)
    content.Position = UDim2.fromScale(0.5, 0.5)
    content.Size = UDim2.fromScale(1, 1)
    content.BackgroundTransparency = 1
    content.Parent = root
    Window.Content = content

    local popScale = Instance.new("UIScale")
    popScale.Parent = content

    local function place(inst, x, y, w, h)
        inst.Position = UDim2.fromOffset(x * K, y * K)
        inst.Size = UDim2.fromOffset(w * K, h * K)
    end

    -- Notification (đỏ -> xanh orbit)
    function Window:Notify(msg)
        if not Window.NotifOn then return end
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0)
        f.Size = UDim2.fromOffset(320, 46)
        f.Position = UDim2.new(0.5, 0, 0, -70)
        f.BorderSizePixel = 0
        stroke(f, 3)
        crystal(f, 0.15)                       -- orbit
        text(f, msg, 20, { Size = UDim2.fromScale(1, 1) })
        f.Parent = gui
        tween(f, 0.3, { Position = UDim2.new(0.5, 0, 0, 24) })
        task.delay(2, function()
            if f.Parent then
                tween(f, 0.3, { Position = UDim2.new(0.5, 0, 0, -70) })
                task.wait(0.35)
                f:Destroy()
            end
        end)
    end

    -- Shape group (khung ngoài màu BẠC)
    local function shapeGroup(name, rects)
        local PAD, B = 8, 4
        local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
        for _, r in ipairs(rects) do
            minX = math.min(minX, r[1]); minY = math.min(minY, r[2])
            maxX = math.max(maxX, r[1] + r[3]); maxY = math.max(maxY, r[2] + r[4])
        end
        local grp = Instance.new("CanvasGroup")
        grp.Name = name
        grp.BackgroundTransparency = 1
        grp.Position = UDim2.fromOffset(minX * K - PAD, minY * K - PAD)
        grp.Size = UDim2.fromOffset((maxX - minX) * K + PAD * 2, (maxY - minY) * K + PAD * 2)
        grp.GroupTransparency = GRAY_T
        grp.Parent = content

        local function rectFrame(r, grow, color)
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0
            f.BackgroundColor3 = color
            f.Position = UDim2.fromOffset((r[1] - minX) * K + PAD - grow, (r[2] - minY) * K + PAD - grow)
            f.Size = UDim2.fromOffset(r[3] * K + grow * 2, r[4] * K + grow * 2)
            f.Parent = grp
        end
        for _, r in ipairs(rects) do rectFrame(r, B, OUTLINE) end
        for _, r in ipairs(rects) do rectFrame(r, 0, PANEL) end -- BẠC
        table.insert(Window.Shapes, grp)
        return grp
    end

