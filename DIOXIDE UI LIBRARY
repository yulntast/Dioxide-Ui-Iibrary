--==============================================================
-- THEME
--==============================================================
local FONT     = Enum.Font.FredokaOne
local WHITE    = Color3.new(1, 1, 1)
local OUTLINE  = Color3.fromRGB(8, 12, 10)
local PANEL    = Color3.fromRGB(122, 128, 132)
local GREEN_L  = Color3.fromRGB(175, 255, 210)
local GREEN    = Color3.fromRGB(45, 222, 128)
local GREEN_D  = Color3.fromRGB(6, 100, 55)
local OFF      = Color3.fromRGB(105, 45, 50)
local DARK     = Color3.fromRGB(14, 20, 18)

local K              = 1.5
local BASE_W, BASE_H = 528, 465
local GRAY_T         = 0.35

-- Vị trí 6 tab quanh chữ L. Thêm tab thứ 7 sẽ dùng lại slot 1.
local TAB_SLOTS = {
    {  53,  18, 100, 55 },
    { 179,  18, 120, 55 },
    {   0,  98, 102, 58 },
    { 426, 206, 102, 58 },
    { 426, 291, 102, 58 },
    { 323, 375, 101, 58 },
}

--==============================================================
-- HELPERS
--==============================================================
-- Squared style: no-op, bỏ mọi bo góc
local function corner(inst, r) return nil end

local function stroke(inst, thick, color, transp)
    local s = Instance.new("UIStroke")
    s.Thickness = thick
    s.Color = color or OUTLINE
    s.Transparency = transp or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

local function crystal(inst, transp, r, light, mid, dark)
    r = r or 10
    inst.BackgroundColor3 = WHITE
    inst.BackgroundTransparency = transp or 0.15
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, light or GREEN_L),
        ColorSequenceKeypoint.new(0.45, mid or GREEN),
        ColorSequenceKeypoint.new(1, dark or GREEN_D),
    })
    g.Rotation = 90
    g.Parent = inst

    local gloss = Instance.new("Frame")
    gloss.Name = "Gloss"
    gloss.BorderSizePixel = 0
    gloss.BackgroundColor3 = WHITE
    gloss.Position = UDim2.fromOffset(4, 3)
    gloss.Size = UDim2.new(1, -8, 0.42, 0)
    gloss.ZIndex = 2
    corner(gloss, math.max(r - 3, 4))
    local gg = Instance.new("UIGradient")
    gg.Rotation = 90
    gg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.3),
        NumberSequenceKeypoint.new(1, 1),
    })
    gg.Parent = gloss
    gloss.Parent = inst

    local edge = Instance.new("Frame")
    edge.Name = "Edge"
    edge.BackgroundTransparency = 1
    edge.Position = UDim2.fromOffset(2, 2)
    edge.Size = UDim2.new(1, -4, 1, -4)
    edge.ZIndex = 2
    corner(edge, math.max(r - 1, 3))
    stroke(edge, 1.5, WHITE, 0.6)
    edge.Parent = inst
end

local function newText(parent, txt, size, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Font = FONT
    l.Text = txt
    l.TextSize = size
    l.TextColor3 = WHITE
    l.ZIndex = 5
    l.TextXAlignment = Enum.TextXAlignment.Center
    for k, v in pairs(props or {}) do l[k] = v end
    local s = Instance.new("UIStroke")
    s.Thickness = math.max(1.5, size / 12)
    s.Color = OUTLINE
    s.Parent = l
    l.Parent = parent
    return l
end

local function tw(inst, t, goal, style, dir)
    local t1 = TweenService:Create(
        inst,
        TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        goal
    )
    t1:Play()
    return t1
end

local function place(inst, x, y, w, h)
    inst.Position = UDim2.fromOffset(x * K, y * K)
    inst.Size     = UDim2.fromOffset(w * K, h * K)
end

--==============================================================
-- WINDOW CLASS
--==============================================================
local WindowClass = {}
WindowClass.__index = WindowClass

function WindowClass.new(opts)
    opts = opts or {}
    local self = setmetatable({}, WindowClass)

    self._opts         = opts
    self._conns        = {}
    self._shapes       = {}
    self._tabs         = {}
    self._pages        = {}
    self._order        = 0
    self._activeCount  = 0
    self._notifOn      = true
    self._opened       = true
    self._userScale    = 1
    self._title        = opts.Title or "Dioxide Hub"
    self._subtitle     = opts.Subtitle or "Test build - Fake features"
    self._version      = opts.Version or "V1.2"

    -- dọn UI cũ nếu có
    for _, g in ipairs({ defaultParent, playerGui }) do
        local old = g:FindFirstChild("DioxideHub")
        if old then old:Destroy() end
    end

    self:_buildShell()
    self:_buildInfo()
    self:_buildCloseOpen()
    self:_bindInput(opts.Key or Enum.KeyCode.RightControl)
    self:_startLoop()
    return self
end

-- Tiện ích con
function WindowClass:_connect(sig, fn)
    local c = sig:Connect(fn)
    table.insert(self._conns, c)
    return c
end

function WindowClass:_nextOrder()
    self._order = self._order + 1
    return self._order
end

function WindowClass:_bumpCount(d)
    self._activeCount = self._activeCount + d
    if self._activeLabel then
        self._activeLabel.Text = "Enabled: " .. self._activeCount
    end
end

--==============================================================
-- BUILD: SHELL (gui, root, content, shapes, mainBox, header)
--==============================================================
function WindowClass:_buildShell()
    local gui = Instance.new("ScreenGui")
    gui.Name = "DioxideHub"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = defaultParent
    self._gui = gui

    local root = Instance.new("Frame")
    root.Name = "Root"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
    root.Size = UDim2.fromOffset(BASE_W * K, BASE_H * K)
    root.BackgroundTransparency = 1
    root.Parent = gui
    self._root = root

    local fitScale = Instance.new("UIScale")
    fitScale.Parent = root
    self._fitScale = fitScale

    local function fit()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local base = math.clamp(
            math.min(vp.X * 0.96 / (BASE_W * K), vp.Y * 0.94 / (BASE_H * K)),
            0.35, 1
        )
        fitScale.Scale = base * self._userScale
    end
    self._fit = fit
    fit()
    if workspace.CurrentCamera then
        self:_connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), fit)
    end

    local content = Instance.new("Frame")
    content.Name = "Content"
    content.AnchorPoint = Vector2.new(0.5, 0.5)
    content.Position = UDim2.fromScale(0.5, 0.5)
    content.Size = UDim2.fromScale(1, 1)
    content.BackgroundTransparency = 1
    content.Parent = root
    self._content = content

    local popScale = Instance.new("UIScale")
    popScale.Parent = content
    self._popScale = popScale

    -- Shapes (L-shape + main box) - dạng canvas group xám
    local function shapeGroup(name, rects)
        local PAD, B = 8, 4
        local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
        for _, r in ipairs(rects) do
            minX = math.min(minX, r[1])
            minY = math.min(minY, r[2])
            maxX = math.max(maxX, r[1] + r[3])
            maxY = math.max(maxY, r[2] + r[4])
        end
        local grp = Instance.new("CanvasGroup")
        grp.Name = name
        grp.BackgroundTransparency = 1
        grp.Position = UDim2.fromOffset(minX * K - PAD, minY * K - PAD)
        grp.Size = UDim2.fromOffset(
            (maxX - minX) * K + PAD * 2,
            (maxY - minY) * K + PAD * 2
        )
        grp.GroupTransparency = GRAY_T
        grp.Parent = content

        local function rectFrame(r, grow, color, radius)
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0
            f.BackgroundColor3 = color
            f.Position = UDim2.fromOffset(
                (r[1] - minX) * K + PAD - grow,
                (r[2] - minY) * K + PAD - grow
            )
            f.Size = UDim2.fromOffset(r[3] * K + grow * 2, r[4] * K + grow * 2)
            corner(f, radius)
            f.Parent = grp
        end
        for _, r in ipairs(rects) do rectFrame(r, B, OUTLINE, 15) end
        for _, r in ipairs(rects) do rectFrame(r, 0, PANEL, 11) end
        table.insert(self._shapes, grp)
        return grp
    end

    local mainShape = shapeGroup("MainShape", { { 129, 86, 284, 263 } })
    local lShape    = shapeGroup("LShape", {
        { 0, 195, 106, 270 },
        { 97, 361, 208, 104 },
    })

    -- Drag root
    local function attachDrag(handle)
        local dragging, dragStart, startPos = false, nil, nil
        handle.Active = true
        self:_connect(handle.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos  = root.Position
            end
        end)
        self:_connect(UserInputService.InputChanged, function(input)
            if dragging and (
                input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch
            ) then
                local d = input.Position - dragStart
                root.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
        self:_connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end
    attachDrag(lShape)
    attachDrag(mainShape)

    -- Main box (chứa header + pages)
    local mainBox = Instance.new("Frame")
    mainBox.Name = "MainBox"
    mainBox.BackgroundTransparency = 1
    mainBox.ClipsDescendants = true
    place(mainBox, 129, 86, 284, 263)
    mainBox.Parent = content
    self._mainBox = mainBox

    local header = Instance.new("Frame")
    header.Position = UDim2.fromOffset(8, 8)
    header.Size = UDim2.new(1, -16, 0, 46)
    header.BorderSizePixel = 0
    corner(header, 9)
    stroke(header, 3)
    crystal(header, 0.08, 9)
    header.Parent = mainBox
    self._headerTitle = newText(header, self._title, 30, { Size = UDim2.fromScale(1, 1) })
end

