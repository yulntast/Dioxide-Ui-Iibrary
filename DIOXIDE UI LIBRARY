    self:EnableResize()
    self.Tabs = {}

    return self
end

function UILibrary:SetBlur(enabled)
    if not self.Blur then return end
    if enabled then
        self.Blur.Enabled = true
        TweenService:Create(self.Blur, TWEEN_FAST, {Size = 16}):Play()
    else
        local tw = TweenService:Create(self.Blur, TWEEN_FAST, {Size = 0})
        tw:Play()
        tw.Completed:Connect(function()
            if self.Blur and self.Blur.Size == 0 then
                self.Blur.Enabled = false
            end
        end)
    end
end

function UILibrary:Destroy()
    self:SetBlur(false)
    for _, conn in pairs(self.Connections) do
        if conn and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(self.Connections)

    if self.ScreenGui then self.ScreenGui:Destroy() end
end

function UILibrary:HideToFloating()
    self:SetBlur(false)
    local tWin = TweenService:Create(self.MainCanvasGroup, TWEEN_FAST, {GroupTransparency = 1})
    tWin:Play()
    tWin.Completed:Connect(function()
        if self.MainCanvasGroup and self.MainCanvasGroup.Parent and self.MainCanvasGroup.GroupTransparency == 1 then
            self.MainCanvasGroup.Visible = false
        end
    end)

    self.ToggleFloatBtn.Visible = true
    self.ToggleFloatBtn.ImageTransparency = 1
    self.ToggleFloatBtn.BackgroundTransparency = 1
    TweenService:Create(self.ToggleFloatBtn, TWEEN_FAST, {ImageTransparency = 0, BackgroundTransparency = 0}):Play()
end

function UILibrary:RestoreFromFloating()
    local tLogo = TweenService:Create(self.ToggleFloatBtn, TWEEN_FAST, {ImageTransparency = 1, BackgroundTransparency = 1})
    tLogo:Play()
    tLogo.Completed:Connect(function()
        if self.ToggleFloatBtn and self.ToggleFloatBtn.Parent and self.ToggleFloatBtn.ImageTransparency == 1 then
            self.ToggleFloatBtn.Visible = false
        end
    end)

    self.MainCanvasGroup.Visible = true
    self.MainCanvasGroup.GroupTransparency = 1
    TweenService:Create(self.MainCanvasGroup, TWEEN_FAST, {GroupTransparency = 0}):Play()

    if not self.IsCollapsed then
        self:SetBlur(true)
    end
end

function UILibrary:ToggleCollapse()
    self.IsCollapsed = not self.IsCollapsed
    if self.IsCollapsed then
        self.LastExpandedSize = Vector2.new(self.MainFrame.AbsoluteSize.X, self.MainFrame.AbsoluteSize.Y)
        self:SetBlur(false)
        TweenService:Create(self.MainFrame, TWEEN_FAST, {Size = UDim2.new(0, self.MainFrame.AbsoluteSize.X, 0, 32)}):Play()
        self.ContentContainer.Visible = false
        self.TopTabBar.Visible = false
        self.ResizeBtn.Visible = false
    else
        self.ContentContainer.Visible = true
        self.TopTabBar.Visible = true
        self.ResizeBtn.Visible = true
        TweenService:Create(self.MainFrame, TWEEN_FAST, {Size = UDim2.new(0, self.LastExpandedSize.X, 0, self.LastExpandedSize.Y)}):Play()
        self:SetBlur(true)
    end
end

function UILibrary:EnableSmoothDrag()
    local dragging = false
    local dragStart = Vector3.new()
    local startPos = UDim2.new()

    self.MainFrame.InputBegan:Connect(function(input)
        if self.IsResizing then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
        end
    end)

    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and not self.IsResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            self.TargetDragPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    table.insert(self.Connections, RunService.RenderStepped:Connect(function()
        if self.TargetDragPos and self.MainFrame and self.MainFrame.Parent then
            local curr = self.MainFrame.Position
            local targ = self.TargetDragPos
            local diffX = math.abs(curr.X.Offset - targ.X.Offset)
            local diffY = math.abs(curr.Y.Offset - targ.Y.Offset)

            if dragging or diffX > 0.1 or diffY > 0.1 then
                self.MainFrame.Position = curr:Lerp(targ, 0.22)
            else
                self.MainFrame.Position = targ
            end
        end
    end))
end

function UILibrary:EnableResize()
    local resizeStart, startSize

    self.ResizeBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.IsResizing = true
            resizeStart = input.Position
            startSize = self.MainFrame.Size
        end
    end)

    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.IsResizing = false
        end
    end))

    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if self.IsResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - resizeStart
            self.MainFrame.Size = UDim2.new(0, math.max(420, startSize.X.Offset + delta.X), 0, math.max(240, startSize.Y.Offset + delta.Y))
        end
    end))
end

