            g.Rotation = 90
            g.Parent = r
            r.Parent = page
            return r
        end

        local function hoverRow(r, btn)
            table.insert(Window.Conns, btn.MouseEnter:Connect(function() tween(r, 0.1, { BackgroundTransparency = 0.1 }) end))
            table.insert(Window.Conns, btn.MouseLeave:Connect(function() tween(r, 0.1, { BackgroundTransparency = 0.25 }) end))
        end

        function TabObj:CreateSection(title)
            local f = Instance.new("Frame")
            f.BackgroundTransparency = 1
            f.Size = UDim2.new(1, -6, 0, 26)
            f.LayoutOrder = ord()
            f.Parent = page
            local up = string.upper(title)
            local w = TextService:GetTextSize(up, 18, FONT, Vector2.new(400, 30)).X
            -- Chữ đỏ
            text(f, up, 18, { Size = UDim2.fromOffset(w + 4, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = RED_L })
            -- Gạch xanh
            local line = Instance.new("Frame")
            line.Position = UDim2.fromOffset(w + 14, 12)
            line.Size = UDim2.new(1, -(w + 14), 0, 2)
            line.BackgroundColor3 = BLUE
            line.BackgroundTransparency = 0.35
            line.BorderSizePixel = 0
            line.Parent = f
        end

        function TabObj:CreateStatCards(t1, v1, t2, v2)
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -6, 0, 66)
            row.BackgroundTransparency = 1
            row.LayoutOrder = ord()
            row.Parent = page
            local setters = {}
            for i, d in ipairs({ { t1, v1 }, { t2, v2 } }) do
                local c = Instance.new("Frame")
                c.Size = UDim2.new(0.5, -4, 1, 0)
                c.Position = UDim2.new((i - 1) * 0.5, (i - 1) * 4, 0, 0)
                c.BackgroundColor3 = DARK
                c.BackgroundTransparency = 0.25
                c.BorderSizePixel = 0
                stroke(c, 2)
                c.Parent = row
                -- Tiêu đề đỏ
                text(c, string.upper(d[1]), 15, { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 18), TextColor3 = RED_L })
                -- Giá trị trắng
                local v = text(c, d[2], 28, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 34) })
                setters[i] = function(s) v.Text = tostring(s) end
            end
            return setters[1], setters[2]
        end

        function TabObj:CreateToggle(label, default, cb, countIt)
            if countIt == nil then countIt = true end
            local r = rowFrame(46)
            local accent = Instance.new("Frame")
            accent.Position = UDim2.fromOffset(6, 9)
            accent.Size = UDim2.new(0, 4, 1, -18)
            accent.BorderSizePixel = 0
            accent.Parent = r

            text(r, label, 22, { Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -100, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })

            local track = Instance.new("Frame")
            track.AnchorPoint = Vector2.new(1, 0.5)
            track.Position = UDim2.new(1, -12, 0.5, 0)
            track.Size = UDim2.fromOffset(60, 28)
            track.BorderSizePixel = 0
            stroke(track, 2)
            track.Parent = r

            -- Gradient orbit cho toggle khi ON
            local trackGrad = Instance.new("UIGradient")
            trackGrad.Name = "StateGrad"
            trackGrad.Rotation = 45
            trackGrad.Color = ColorSequence.new(RED, Color3.fromRGB(150, 60, 140), BLUE)
            trackGrad.Enabled = false
            trackGrad.Parent = track

            local knob = Instance.new("Frame")
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Size = UDim2.fromOffset(22, 22)
            knob.BackgroundColor3 = WHITE
            knob.BorderSizePixel = 0
            stroke(knob, 2, BLUE_L)
            knob.Parent = track

            local state = default or false
            local function render(animate)
                local pos = UDim2.new(0, state and 47 or 13, 0.5, 0)
                trackGrad.Enabled = state
                local baseCol = state and WHITE or OFF
                local acc = state and RED or Color3.fromRGB(50, 55, 60)
                if animate then
                    tween(track, 0.15, { BackgroundColor3 = baseCol })
                    tween(accent, 0.15, { BackgroundColor3 = acc })
                    tween(knob, 0.18, { Position = pos }, Enum.EasingStyle.Back)
                else
                    track.BackgroundColor3 = baseCol
                    accent.BackgroundColor3 = acc
                    knob.Position = pos
                end
            end
            render(false)
            if default and countIt then Window:Bump(1) end

            local click = Instance.new("TextButton")
            click.Text = ""
            click.BackgroundTransparency = 1
            click.Size = UDim2.fromScale(1, 1)
            click.ZIndex = 8
            click.Parent = r
            hoverRow(r, click)

            table.insert(Window.Conns, click.MouseButton1Click:Connect(function()
                state = not state
                render(true)
                if countIt then Window:Bump(state and 1 or -1) end
                Window:Notify(label .. ": " .. (state and "ON" or "OFF"))
                if cb then cb(state) end
            end))
        end

        function TabObj:CreateSlider(label, min, max, default, suffix, cb)
            suffix = suffix or ""
            local r = rowFrame(68)
            text(r, label, 22, { Position = UDim2.fromOffset(14, 4), Size = UDim2.new(1, -110, 0, 26), TextXAlignment = Enum.TextXAlignment.Left })

            -- Giá trị XANH
            local val = text(r, default .. suffix, 22, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 4), Size = UDim2.fromOffset(90, 26), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = BLUE_L })

            local hit = Instance.new("TextButton")
            hit.Text = ""
            hit.BackgroundTransparency = 1
            hit.Position = UDim2.fromOffset(10, 34)
            hit.Size = UDim2.new(1, -20, 0, 30)
            hit.Parent = r

            local bar = Instance.new("Frame")
            bar.AnchorPoint = Vector2.new(0, 0.5)
            bar.Position = UDim2.new(0, 4, 0.5, 0)
            bar.Size = UDim2.new(1, -8, 0, 14)
            bar.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
            bar.BorderSizePixel = 0
            stroke(bar, 2)
            bar.Parent = hit

            local fill = Instance.new("Frame")
            fill.Size = UDim2.fromScale(0, 1)
            fill.BorderSizePixel = 0
            crystal(fill, 0)                        -- orbit đỏ-xanh
            fill.Parent = bar

            local knob = Instance.new("Frame")
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Size = UDim2.fromOffset(22, 22)
            knob.BackgroundColor3 = WHITE
            knob.BorderSizePixel = 0
            stroke(knob, 3, BLUE)
            knob.ZIndex = 4
            knob.Parent = bar

            local function setAlpha(a)
                fill.Size = UDim2.fromScale(a, 1)
                knob.Position = UDim2.fromScale(a, 0.5)
            end
            setAlpha((default - min) / (max - min))

            local dragging = false
            local function fromX(x)
                local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                local v = math.floor(min + (max - min) * a + 0.5)
                setAlpha((v - min) / (max - min))
                val.Text = v .. suffix
                if cb then cb(v) end
            end

            table.insert(Window.Conns, hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    tween(knob, 0.1, { Size = UDim2.fromOffset(27, 27) })
                    fromX(input.Position.X)
                end
            end))
            table.insert(Window.Conns, UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    fromX(input.Position.X)
                end
            end))
            table.insert(Window.Conns, UserInputService.InputEnded:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    dragging = false
                    tween(knob, 0.1, { Size = UDim2.fromOffset(22, 22) })
                end
            end))
        end

        function TabObj:CreateSelector(label, options, cb)
            local r = rowFrame(46)
            text(r, label, 22, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -200, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })

            local i = 1
            local val = text(r, options[i] or "", 18, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -44, 0.5, 0), Size = UDim2.fromOffset(116, 30), TextColor3 = BLUE_L, TextTruncate = Enum.TextTruncate.AtEnd })

            local function smallBtn(symbol, pos)
                local b = Instance.new("TextButton")
                b.Text = ""
                b.AutoButtonColor = false
                b.AnchorPoint = Vector2.new(1, 0.5)
                b.Position = pos
                b.Size = UDim2.fromOffset(30, 30)
                b.BorderSizePixel = 0
                b.ZIndex = 9
                stroke(b, 2)
                crystal(b, 0.1)                     -- orbit
                text(b, symbol, 22, { Size = UDim2.fromScale(1, 1), ZIndex = 10 })
                b.Parent = r
                return b
            end

            local prev = smallBtn("<", UDim2.new(1, -164, 0.5, 0))
            local nxt  = smallBtn(">", UDim2.new(1, -10,  0.5, 0))

            local function step(d)
                if #options == 0 then return end
                i = (i - 1 + d) % #options + 1
                val.Text = options[i]
                Window:Notify(label .. ": " .. options[i])
                if cb then cb(options[i]) end
            end

            table.insert(Window.Conns, prev.MouseButton1Click:Connect(function() step(-1) end))
            table.insert(Window.Conns, nxt.MouseButton1Click:Connect(function() step(1) end))
        end

        function TabObj:CreateButton(label, cb)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -6, 0, 46)
            b.Text = ""
            b.AutoButtonColor = false
            b.BorderSizePixel = 0
            b.LayoutOrder = ord()
            stroke(b, 3)
            crystal(b, 0.1)                        -- orbit
            text(b, label, 22, { Size = UDim2.fromScale(1, 1), ZIndex = 4 })
            local sc = Instance.new("UIScale")
            sc.Parent = b

            table.insert(Window.Conns, b.MouseEnter:Connect(function() tween(sc, 0.12, { Scale = 1.02 }) end))
            table.insert(Window.Conns, b.MouseLeave:Connect(function() tween(sc, 0.12, { Scale = 1 }) end))
            table.insert(Window.Conns, b.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 0.96 }) end))
            table.insert(Window.Conns, b.MouseButton1Up:Connect(function() tween(sc, 0.08, { Scale = 1.02 }) end))
            table.insert(Window.Conns, b.MouseButton1Click:Connect(function()
                Window:Notify(label)
                if cb then cb() end
            end))
            b.Parent = page
        end

        function TabObj:CreateProgress(label, cur, max)
            local r = rowFrame(62)
            text(r, label, 22, { Position = UDim2.fromOffset(14, 4), Size = UDim2.new(1, -28, 0, 26), TextXAlignment = Enum.TextXAlignment.Left })

            local bar = Instance.new("Frame")
            bar.Position = UDim2.fromOffset(14, 34)
            bar.Size = UDim2.new(1, -28, 0, 20)
            bar.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
            bar.BorderSizePixel = 0
            stroke(bar, 2)
            bar.Parent = r

            local fill = Instance.new("Frame")
            fill.Size = UDim2.fromScale(cur / max, 1)
            fill.BorderSizePixel = 0
            crystal(fill, 0)                       -- orbit
            fill.Parent = bar

            local lbl = text(bar, cur .. "/" .. max, 16, { Size = UDim2.fromScale(1, 1), ZIndex = 6 })

            return function(c)
                tween(fill, 0.3, { Size = UDim2.fromScale(math.clamp(c / max, 0, 1), 1) })
                lbl.Text = c .. "/" .. max
            end
        end

        return TabObj
    end

    return Window
end

return Library
