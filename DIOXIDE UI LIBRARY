end

local function AnimateUI(canvasGroup, show)
    local isMini = (canvasGroup.Name == "MiniUI")
    local baseSize = isMini and UDim2.new(0, 110, 0, 32) or UDim2.new(0, 520, 0, 320)

    canvasGroup.Size = baseSize

    if show then
        canvasGroup.Visible = true
        canvasGroup.GroupTransparency = 1
        TweenService:Create(canvasGroup, TWEEN_FAST, {GroupTransparency = 0}):Play()
    else
        local tw = TweenService:Create(canvasGroup, TWEEN_FAST, {GroupTransparency = 1})
        tw:Play()
        tw.Completed:Connect(function()
            if canvasGroup and canvasGroup.Parent and canvasGroup.GroupTransparency == 1 then
                canvasGroup.Visible = false
            end
        end)
    end
end

local function GetSafeParent()
    local success, parent = pcall(function()
        if gethui then return gethui() end
        return CoreGui:FindFirstChild("RobloxGui") or CoreGui
    end)
    return (success and parent) or LocalPlayer:WaitForChild("PlayerGui")
end

